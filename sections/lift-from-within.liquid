<style>
  .lfw-section {
    width: 100vw !important;
    max-width: 100vw !important;
    padding: 60px 0 !important;
    background: #ffffff !important;
    font-family: 'Inter', -apple-system, sans-serif;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw !important;
    margin-right: -50vw !important;
  }
  .lfw-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  /* ===== Left: Image with Layer Labels ===== */
  .lfw-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 16px;
    overflow: hidden;
    background: #f5f0eb;
  }
  .lfw-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .lfw-layer-label {
    position: absolute;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(4px);
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 600;
    color: #1a1a1a;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    pointer-events: none;
  }
  .lfw-label-1 { top: 15%; left: 10%; }
  .lfw-label-2 { top: 35%; right: 12%; }
  .lfw-label-3 { bottom: 30%; left: 8%; }
  .lfw-label-4 { bottom: 12%; right: 10%; }

  /* ===== Right: Content ===== */
  .lfw-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .lfw-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #5d308c;
    text-transform: uppercase;
    margin: 0;
  }
  .lfw-title {
    font-size: 2.2rem;
    font-weight: 800;
    color: #1a1a1a;
    margin: 0;
    line-height: 1.2;
  }
  .lfw-desc {
    font-size: 1rem;
    line-height: 1.7;
    color: #555;
    margin: 0;
  }
  .lfw-subtitle {
    font-size: 1.1rem;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0;
  }
  .lfw-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .lfw-features li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.95rem;
    color: #444;
    line-height: 1.5;
  }
  .lfw-features li::before {
    content: "✓";
    color: #5d308c;
    font-weight: 700;
    font-size: 1.1rem;
  }

  /* ===== Button ===== */
  .lfw-button {
    display: inline-block;
    background: #0066ff;
    color: #ffffff;
    padding: 14px 40px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    text-align: center;
    transition: background 0.3s, transform 0.3s, box-shadow 0.3s;
    box-shadow: 0 4px 16px rgba(0,102,255,0.25);
    border: none;
    cursor: pointer;
    width: fit-content;
    font-family: inherit;
  }
  .lfw-button:hover {
    background: #000000;
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 8px 30px rgba(0,0,0,0.15);
  }

  @media (max-width: 768px) {
    .lfw-container {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 0 16px;
    }
    .lfw-title { font-size: 1.8rem; }
    .lfw-button { width: 100%; text-align: center; }
    .lfw-layer-label { font-size: 0.6rem; padding: 2px 10px; }
  }
</style>

<section class="lfw-section">
  <div class="lfw-container">
    
    <!-- Left: Image with Layer Labels -->
    <div class="lfw-image-wrapper">
      {% if section.settings.main_image != blank %}
        <img src="{{ section.settings.main_image | image_url: width: 800 }}" alt="Skin layers" loading="lazy">
      {% else %}
        <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:#f0ece6; color:#aaa; font-size:0.9rem;">Upload Image</div>
      {% endif %}
      <span class="lfw-layer-label lfw-label-1">🧬 Dermis</span>
      <span class="lfw-layer-label lfw-label-2">🔬 SMAS Layer</span>
      <span class="lfw-layer-label lfw-label-3">💪 Muscle Layer</span>
      <span class="lfw-layer-label lfw-label-4">⬆️ Lift Direction</span>
    </div>

    <!-- Right: Content -->
    <div class="lfw-content">
      <p class="lfw-eyebrow">{{ section.settings.eyebrow | default: "ADVANCED TECHNOLOGY" }}</p>
      <h2 class="lfw-title">{{ section.settings.title | default: "Lift From Within with Advanced Microcurrent Technology" }}</h2>
      <p class="lfw-desc">{{ section.settings.description | default: "Powered by gentle micro-current technology, this device works beneath the surface to support skin firmness and facial definition." }}</p>
      <p class="lfw-subtitle">{{ section.settings.subtitle | default: "The result?" }}</p>
      <ul class="lfw-features">
        <li>{{ section.settings.feature_1 | default: "Supports skin tightening" }}</li>
        <li>{{ section.settings.feature_2 | default: "Helps reduce the look of edema and fatigue" }}</li>
        <li>{{ section.settings.feature_3 | default: "Promotes a firmer, sculpted appearance" }}</li>
        <li>{{ section.settings.feature_4 | default: "Safe, non-invasive, and easy to use at home" }}</li>
      </ul>
      <a href="{{ section.settings.button_link | default: '#' }}" class="lfw-button">{{ section.settings.button_text | default: "Experience the Benefits Today" }}</a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Lift From Within",
  "enabled_on": {
    "templates": ["*"],
    "groups": ["*"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "ADVANCED TECHNOLOGY"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "Lift From Within with Advanced Microcurrent Technology"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Powered by gentle micro-current technology, this device works beneath the surface to support skin firmness and facial definition."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The result?"
    },
    {
      "type": "text",
      "id": "feature_1",
      "label": "Feature 1",
      "default": "Supports skin tightening"
    },
    {
      "type": "text",
      "id": "feature_2",
      "label": "Feature 2",
      "default": "Helps reduce the look of edema and fatigue"
    },
    {
      "type": "text",
      "id": "feature_3",
      "label": "Feature 3",
      "default": "Promotes a firmer, sculpted appearance"
    },
    {
      "type": "text",
      "id": "feature_4",
      "label": "Feature 4",
      "default": "Safe, non-invasive, and easy to use at home"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Experience the Benefits Today"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Lift From Within",
      "category": "Custom"
    }
  ]
}
{% endschema %}
