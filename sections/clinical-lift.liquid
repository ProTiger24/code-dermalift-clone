{{ 'clinical-lift.css' | asset_url | stylesheet_tag }}

<section class="clinical-section">
  <div class="clinical-container site-container">
    <div class="clinical-content">
      <h2 class="clinical-title">Clinically Inspired Facial Lifting — Without Surgery</h2>
      <p class="clinical-subtitle">Meet DERMALIFT™ EMS V Face Sculpting Device</p>
      <p class="clinical-description">
        DermaLift™ combines EMS microcurrent stimulation with a precision 3D V-roller to activate facial muscles, lift skin, and restore firmness naturally.
      </p>

      <div class="clinical-list">
        <div class="clinical-item">
          <span class="clinical-icon">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z" fill="currentColor"/>
            </svg>
          </span>
          <strong>EMS microcurrent technology activates facial muscles</strong>
        </div>

        <div class="clinical-item">
          <span class="clinical-icon">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2v20M2 12h20M5 9l-3 3 3 3M19 9l3 3-3 3M9 5l3-3 3 3M9 19l3 3 3-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <strong>V-shaped rollers sculpt and lift facial contours</strong>
        </div>

        <div class="clinical-item">
          <span class="clinical-icon">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 11l9-8 9 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M5 10v10h14V10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M10 20v-6h4v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <strong>Professional results from the comfort of home</strong>
        </div>
      </div>
    </div>

    <div class="clinical-image">
      <img
        src="{{ 'feature2.webp' | asset_url }}"
        alt="DermaLift EMS device in use"
        width="800"
        height="960"
        loading="lazy"
      >
    </div>
  </div>

  <div class="clinical-cta">
    <a href="https://www.dermalift.top/products/v-face-lifting-skin-tightening-skin-care-wrinkle-remover-face-sculpting-tools-ems-microcurrent-3d-roller-massager" class="clinical-button">
      Get DERMALIFT™ Now
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="9" cy="20" r="1.4" fill="currentColor"/>
        <circle cx="18" cy="20" r="1.4" fill="currentColor"/>
        <path d="M2 3h2l2.4 12.2a2 2 0 0 0 2 1.6h8.6a2 2 0 0 0 2-1.6L21 7H6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Clinical Lift Section",
  "settings": [
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Get DERMALIFT™ Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Clinical Lift Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}
