{{ 'site-footer.css' | asset_url | stylesheet_tag }}

<footer class="sf-footer">
  <div class="sf-main">
    <div class="sf-col sf-brand">
      <div class="sf-logo">{{ section.settings.logo_text }}</div>
      <p class="sf-description">{{ section.settings.description }}</p>
    </div>

    <div class="sf-col">
      <h4 class="sf-heading">{{ section.settings.info_heading }}</h4>
      <ul class="sf-links">
        {% for link in section.settings.info_menu.links %}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="sf-col">
      <h4 class="sf-heading">{{ section.settings.nav_heading }}</h4>
      <ul class="sf-links">
        {% for link in section.settings.nav_menu.links %}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="sf-col sf-subscribe">
      <h4 class="sf-heading">{{ section.settings.subscribe_heading }}</h4>
      <p class="sf-subscribe-text">{{ section.settings.subscribe_text }}</p>

      {% form 'customer' %}
        {{ form.errors | default: '' }}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="sf-subscribe-form">
          <span class="sf-mail-icon">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/>
              <path d="M3 7l9 6 9-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <input type="email" name="contact[email]" placeholder="Enter your email" required>
          <button type="submit" aria-label="Subscribe">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
        {% if form.posted_successfully? %}
          <p class="sf-subscribe-success">Thanks for subscribing!</p>
        {% endif %}
      {% endform %}

      <div class="sf-socials">
        {% if section.settings.facebook_url != blank %}
          <a href="{{ section.settings.facebook_url }}" aria-label="Facebook" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13 22v-9h3l.5-3.5H13V7.2c0-1 .3-1.7 1.8-1.7H17V2.3C16.6 2.2 15.4 2 14 2c-2.9 0-4.9 1.8-4.9 5v2.5H6V13h3.1v9H13z"/></svg>
          </a>
        {% endif %}
        {% if section.settings.instagram_url != blank %}
          <a href="{{ section.settings.instagram_url }}" aria-label="Instagram" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
          </a>
        {% endif %}
        {% if section.settings.twitter_url != blank %}
          <a href="{{ section.settings.twitter_url }}" aria-label="Twitter" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 5.9c-.7.3-1.5.6-2.3.7.8-.5 1.4-1.3 1.7-2.3-.8.5-1.7.8-2.6 1a4.1 4.1 0 0 0-7 3.7A11.6 11.6 0 0 1 3.4 4.6a4.1 4.1 0 0 0 1.3 5.5c-.6 0-1.3-.2-1.8-.5v.1c0 2 1.4 3.6 3.3 4a4.1 4.1 0 0 1-1.8.1c.5 1.6 2 2.8 3.8 2.8A8.2 8.2 0 0 1 2 18.6a11.6 11.6 0 0 0 6.3 1.8c7.5 0 11.7-6.3 11.7-11.7v-.5c.8-.6 1.5-1.3 2-2.1z"/></svg>
          </a>
        {% endif %}
        {% if section.settings.youtube_url != blank %}
          <a href="{{ section.settings.youtube_url }}" aria-label="YouTube" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12s0-3.2-.4-4.7c-.3-.9-1-1.6-1.9-1.8C18.1 5 12 5 12 5s-6.1 0-7.7.5c-.9.2-1.6.9-1.9 1.8C2 8.8 2 12 2 12s0 3.2.4 4.7c.3.9 1 1.6 1.9 1.8C5.9 19 12 19 12 19s6.1 0 7.7-.5c.9-.2 1.6-.9 1.9-1.8.4-1.5.4-4.7.4-4.7zM10 15V9l5.2 3-5.2 3z"/></svg>
          </a>
        {% endif %}
        {% if section.settings.tiktok_url != blank %}
          <a href="{{ section.settings.tiktok_url }}" aria-label="TikTok" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 2h-3v13.5a2.6 2.6 0 1 1-2.6-2.6c.2 0 .4 0 .6.1V9.9a5.6 5.6 0 1 0 5 5.6V8.4c1.1.8 2.4 1.2 3.8 1.2V6.6c-2.1 0-3.8-1.7-3.8-3.8V2z"/></svg>
          </a>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="sf-bottom">
    <p>{{ section.settings.copyright_text }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Site Footer",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "DermaLift" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "DERMALIFT™ delivers professional-grade facial sculpting technology in a simple, at-home device. Using clinically inspired EMS microcurrent stimulation and precision V-shaped rollers, our devices help lift, tighten, and redefine facial contours without needles, surgery, or expensive clinic visits. We believe visible results come from consistency, intelligent design, and technology that works with your body's natural processes." },
    { "type": "text", "id": "info_heading", "label": "Column 1 heading", "default": "Informations" },
    { "type": "link_list", "id": "info_menu", "label": "Column 1 menu" },
    { "type": "text", "id": "nav_heading", "label": "Column 2 heading", "default": "Navigations" },
    { "type": "link_list", "id": "nav_menu", "label": "Column 2 menu" },
    { "type": "text", "id": "subscribe_heading", "label": "Subscribe heading", "default": "Subscribe" },
    { "type": "textarea", "id": "subscribe_text", "label": "Subscribe text", "default": "Be the first to know— subscribe to our newsletter to receive insider updates, trends, and exclusive deals." },
    { "type": "header", "content": "Social links" },
    { "type": "url", "id": "facebook_url", "label": "Facebook" },
    { "type": "url", "id": "instagram_url", "label": "Instagram" },
    { "type": "url", "id": "twitter_url", "label": "Twitter / X" },
    { "type": "url", "id": "youtube_url", "label": "YouTube" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok" },
    { "type": "header", "content": "Bottom bar" },
    { "type": "text", "id": "copyright_text", "label": "Copyright text", "default": "Copyright © 2026 DermaLift | Developed by ReadyDropSites" }
  ],
  "presets": [
    { "name": "Site Footer", "category": "Custom" }
  ]
}
{% endschema %}
