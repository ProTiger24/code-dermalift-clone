{{ 'custom-product.css' | asset_url | stylesheet_tag }}

<section class="custom-product-section">
  <div class="custom-product-container">
    
    <!-- ===== Product Image ===== -->
    <div class="product-image">
      <img src="{{ 'product-image.png' | asset_url }}" alt="Dermalift Pro" loading="lazy">
    </div>

    <!-- ===== Product Info ===== -->
    <div class="product-info">
      
      <!-- Rating -->
      <div class="product-rating">
        <span class="stars">★★★★★</span>
        <span class="rating-text">4.9/5 ratings based on 12,000+ Customers</span>
      </div>

      <!-- Title -->
      <h1 class="product-title">Visible Facial Lift in Just Minutes a Day</h1>
      <h2 class="product-subtitle">Dermalift™ Pro Facial Sculptor</h2>

      <!-- Price -->
      <div class="product-price">
        <span class="price-original">$107.00</span>
        <span class="price-sale">$99.99</span>
        <span class="price-save">SAVE 6%</span>
      </div>

      <!-- Features -->
      <ul class="product-features">
        <li>✅ EMS micro-current activates facial muscles</li>
        <li>✅ V-shaped 3D rollers sculpt jawline & cheeks</li>
        <li>✅ Encourages stronger, thicker and healthier hair</li>
        <li>✅ Dermatologist-endorsed for daily uses</li>
        <li>✅ Suitable for all skin types</li>
      </ul>

      <!-- Color -->
      <div class="product-color">
        <span class="color-label">Color:</span>
        <span class="color-value">Black</span>
      </div>

      <!-- Quantity + Add to Cart -->
      <div class="product-actions">
        <div class="quantity-selector">
          <button class="qty-btn" onclick="changeQty(-1)">−</button>
          <input type="number" id="qty-input" value="1" min="1" max="99">
          <button class="qty-btn" onclick="changeQty(1)">+</button>
        </div>
        <a href="#" class="add-to-cart-btn">Add to cart</a>
      </div>

    </div>
  </div>
</section>

<script>
function changeQty(delta) {
  var input = document.getElementById('qty-input');
  var val = parseInt(input.value) + delta;
  if (val < 1) val = 1;
  if (val > 99) val = 99;
  input.value = val;
}
</script>

{% schema %}
{
  "name": "Custom Product",
  "settings": [],
  "presets": [
    {
      "name": "Custom Product",
      "category": "Custom"
    }
  ]
}
{% endschema %}
