{{ 'features.css' | asset_url | stylesheet_tag }}

<section class="features-section">
  <div class="features-container site-container">
    <!-- বাম পাশে টেক্সট ও বক্স -->
    <div class="features-content">
      <h2 class="features-title">Facial Aging Starts Beneath the Skin</h2>
      <p class="features-subtitle">Why skincare alone isn't enough</p>
      <p class="features-description">
        Loss of muscle tone and reduced circulation cause sagging skin, fine lines, puffiness, and a tired appearance that topical products cannot fully correct.
      </p>

      <div class="features-list">
        <div class="feature-item">
          <span class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/>
              <path d="M8 15c1-1.3 2.3-2 4-2s3 0.7 4 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              <circle cx="9" cy="10" r="1" fill="currentColor"/>
              <circle cx="15" cy="10" r="1" fill="currentColor"/>
            </svg>
          </span>
          <strong>Sagging jawline, cheeks, and loss of facial definition</strong>
        </div>

        <div class="feature-item">
          <span class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M7 3h10M7 21h10M7 3c0 4 3.5 5 5 6-1.5 1-5 2-5 6M17 3c0 4-3.5 5-5 6 1.5 1 5 2 5 6" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
            </svg>
          </span>
          <strong>Fine lines and wrinkles becoming more noticeable</strong>
        </div>

        <div class="feature-item">
          <span class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 9c1.5-2 3.5-2 5 0s3.5 2 5 0 3.5-2 5 0 3.5 2 5 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              <path d="M3 15c1.5-2 3.5-2 5 0s3.5 2 5 0 3.5-2 5 0 3.5 2 5 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
          </span>
          <strong>Puffiness and dull skin from poor circulation</strong>
        </div>
      </div>
    </div>

    <!-- ডান পাশে ছবি -->
    <div class="features-image">
      <img
        src="{{ 'feature1.webp' | asset_url }}"
        alt="Facial aging concerns"
        width="800"
        height="960"
        loading="lazy"
      >
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Features",
  "settings": [],
  "presets": [
    {
      "name": "Features",
      "category": "Custom"
    }
  ]
}
{% endschema %}
