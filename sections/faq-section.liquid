{{ 'faq-section.css' | asset_url | stylesheet_tag }}

<section class="faq-section" data-section-id="{{ section.id }}">
  <div class="faq-container">

    <!-- ===== Header (Center Aligned) ===== -->
    <div class="faq-header">
      <h2 class="faq-heading">{{ section.settings.heading | default: "Frequently Asked Questions" }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="faq-subheading">{{ section.settings.subheading | default: "Everything you need to know about Dermalift™" }}</p>
      {% endif %}
    </div>

    <!-- ===== FAQ List ===== -->
    <div class="faq-list">
      {% for block in section.blocks %}
        <div class="faq-item" {{ block.shopify_attributes }}>
          <button class="faq-question" data-faq-toggle aria-expanded="false">
            <span>{{ block.settings.question }}</span>
            <span class="faq-icon">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </button>
          <div class="faq-answer" data-faq-answer>
            <div class="faq-answer-inner">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

<script>
(function () {
  var sectionId = '{{ section.id }}';

  function init(root) {
    var items = root.querySelectorAll('.faq-item');

    items.forEach(function (item) {
      var btn = item.querySelector('[data-faq-toggle]');
      var answer = item.querySelector('[data-faq-answer]');

      btn.addEventListener('click', function () {
        var isOpen = item.classList.contains('is-open');

        items.forEach(function (other) {
          other.classList.remove('is-open');
          other.querySelector('[data-faq-toggle]').setAttribute('aria-expanded', 'false');
          other.querySelector('[data-faq-answer]').style.maxHeight = null;
        });

        if (!isOpen) {
          item.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
          answer.style.maxHeight = answer.scrollHeight + 'px';
        }
      });
    });
  }

  function getRoot() {
    return document.querySelector('.faq-section[data-section-id="' + sectionId + '"]');
  }

  var root = getRoot();
  if (root) init(root);

  document.addEventListener('shopify:section:load', function (evt) {
    if (evt.detail.sectionId !== sectionId) return;
    var newRoot = getRoot();
    if (newRoot) init(newRoot);
  });
})();
</script>

{% schema %}
{
  "name": "FAQ Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to know about Dermalift™"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Is EMS safe for facial use?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes. EMS microcurrent technology has been widely used in professional dermatology and aesthetic clinics for years.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "FAQ Section",
      "category": "Custom",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "Is EMS safe for facial use?",
            "answer": "<p>Yes. EMS (Electrical Muscle Stimulation) microcurrent technology has been widely used in professional dermatology and aesthetic clinics for years. DERMALIFT™ uses carefully calibrated, low-level microcurrents designed specifically for facial muscles, making it safe, controlled, and suitable for at-home use when used as directed.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How often should I use DermaLift™?",
            "answer": "<p>For best results, use DermaLift™ 3–5 times per week, 5–10 minutes per session.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "When will I see results?",
            "answer": "<p>Many users notice a fresher, more lifted look within 2–3 weeks of consistent use.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Is it suitable for all skin types?",
            "answer": "<p>Yes. DERMALIFT™ is designed to be gentle and effective for all skin types, including sensitive skin. The adjustable intensity levels allow you to customize the experience to your comfort level.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Does it hurt?",
            "answer": "<p>No. You'll feel a gentle tingling or micro-pulse sensation, not pain.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Do I need to use a gel or serum?",
            "answer": "<p>Yes, a conductive gel or water-based serum is recommended for smooth glide and optimal conductivity.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Is DermaLift™ rechargeable?",
            "answer": "<p>Yes, DermaLift™ comes with a USB charging cable and offers long battery life per full charge.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
