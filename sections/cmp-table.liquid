{% schema %}
{
  "name": "CMP Table",
  "settings": [
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "GET DERMALIFT™ NOW"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button Link",
      "default": "#"
    }
  ],
  "presets": [
    {
      "name": "CMP Table",
      "category": "Custom"
    }
  ]
}
{% endschema %}
